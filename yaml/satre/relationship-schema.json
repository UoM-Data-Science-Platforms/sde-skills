{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "source", "pillars", "legacy_components", "relationships"],
  "properties": {
    "schema_version": {"const": 3},
    "legacy_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "editorial_summary", "candidate_capability_ids", "mappings"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "editorial_summary": {"type": "string"},
          "candidate_capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "mappings": {
            "type": "object", "additionalProperties": {
              "type": "object", "additionalProperties": {
                "type": "array", "uniqueItems": true, "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability_id", "domain_id", "subdomain_id", "competency_id", "requirement_ids", "contribution", "rationale", "review", "legacy_component_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capability_id": {"type": "string", "pattern": "^[1-5]\\.[0-9]+$"},
          "domain_id": {"type": "string", "minLength": 1},
          "subdomain_id": {"type": "string", "minLength": 1},
          "competency_id": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-5]\\.[0-9]+\\.[0-9]{2}$"}},
          "contribution": {"enum": [null, "direct", "supporting"]},
          "rationale": {"type": ["string", "null"]},
          "legacy_component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "migration_note": {"type": "string"},
          "review": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "reviewer", "reviewed_on"],
            "properties": {
              "status": {"enum": ["pending", "reviewed", "rejected"]},
              "reviewer": {"type": ["string", "null"]},
              "reviewed_on": {"type": ["string", "null"]}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"review": {"properties": {"status": {"const": "reviewed"}}}}},
            "then": {
              "properties": {
                "requirement_ids": {"minItems": 1},
                "contribution": {"enum": ["direct", "supporting"]}
              }
            }
          },
          {
            "if": {"properties": {"review": {"properties": {"status": {"const": "pending"}}}}},
            "then": {
              "properties": {
                "contribution": {"type": "null"},
                "review": {"properties": {"reviewer": {"type": "null"}, "reviewed_on": {"type": "null"}}}
              }
            }
          }
        ]
      }
    }
  }
}
