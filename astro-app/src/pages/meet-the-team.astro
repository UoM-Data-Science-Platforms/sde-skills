---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import StickyNavigation from '../components/StickyNavigation.astro';
import TeamCard from '../components/TeamCard.astro';
import { INSTITUTION_COLORS } from '../data/domains.js';
import { staff } from '../data/staff.js';

const sections = [
  { id: 'team', label: 'Team' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<Layout title="Meet the Team — SDE Team Development Hub" currentDomain="meet-the-team">
  <div class="meet-the-team-page">
    <PageHeader title="Meet the Team" />
    <StickyNavigation sections={sections} />
    <div class="scroll-area" id="scroll-area">
    <div class="container-fluid px-4 py-4">
        <h2 id="team" class="visually-hidden"></h2>
        <div class="team-cards-grid">
          {staff.map((member) => (
            <TeamCard member={member} variant="full" />
          ))}
        </div>
        </div>
    </div>
  </div>
</Layout>


