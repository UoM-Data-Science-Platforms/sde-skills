---
import { Content } from '../../data/cf-framework-mapping.md';
import Layout from '../layouts/Layout.astro';
import StickyNavigation from '../components/StickyNavigation.astro';

const sections = [
  {
    id: 'mapping-to-five-safes',
    label: 'Five Safes',
    subsections: [
      { id: 'safe-data',     label: 'Safe Data'     },
      { id: 'safe-projects', label: 'Safe Projects' },
      { id: 'safe-people',   label: 'Safe People'   },
      { id: 'safe-settings', label: 'Safe Settings' },
      { id: 'safe-outputs',  label: 'Safe Outputs'  },
    ],
  },
  {
    id: 'mapping-to-satre',
    label: 'SATRE v2.0.1',
    subsections: [
      { id: '1-information-governance',                        label: '1. Information Governance'     },
      { id: '2-computing-technology-and-information-security', label: '2. Computing Technology & IS'  },
      { id: '3-data-management',                               label: '3. Data Management'            },
      { id: '4-supporting-capabilities',                       label: '4. Supporting Capabilities'    },
      { id: '5-federation',                                    label: '5. Federation'                 },
    ],
  },
  {
    id: 'cross-cutting-competencies',
    label: 'Cross-Cutting',
    subsections: [
      { id: 'governance--compliance',        label: 'Governance & Compliance'        },
      { id: 'collaboration--communication',  label: 'Collaboration & Communication'  },
    ],
  },
];
---
<Layout title="The SDE RTP Competency Framework Mapping — SDE Team Development Hub" currentDomain="cf-framework-mapping">
  <div class="skills-framework">
    <div class="sticky-header">
      <h1>The SDE RTP Competency Framework Mapping</h1>
    </div>
    <StickyNavigation sections={sections} />
    <div class="scroll-area" id="scroll-area">
      <article class="prose prose--reset">
        <Content />
      </article>
    </div>
  </div>
</Layout>
