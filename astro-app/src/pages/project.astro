---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import MissionGrid from '../components/MissionGrid.jsx';
import StickyNavigation from '../components/StickyNavigation.astro';
import MiniHero from '../components/MiniHero.astro';

const sections = [
  { id: 'project', label: 'About' },
  { id: 'competency-framework', label: 'Our Aims' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<Layout title="Project — SDE Team Development Hub" currentDomain="project">
  <div class="project-page">
    <PageHeader title="Project" />
    <StickyNavigation sections={sections} id="home-subnav" />

    <div class="scroll-area" id="scroll-area">
         <MiniHero title="About the project" id="project">
            <p>The SDE Team Development Hub is a collaboration between like-minded individuals that aims to find better ways to develop and support Research Technical Professionals (RTPs), which underpin the creation of Secure Data Environments (SDEs).</p>
            <p>The SDE Team Development Hub is <a class="link" href={`${base}/acknowledgements`}>funded by the Engineering and Physical Sciences Research Council (EPSRC)</a> and brings together partners across the North West of England to build technical capacity in secure data environments.</p>

            <h2 id="competency-framework">We aim to achieve this by:</h2>            
         </MiniHero>
        <div class="container-fluid px-4 py-4">
          <MissionGrid client:load />
        </div>
      </div>
    </div>
</Layout>

<script>
  // Sticky-below-hero behaviour: nav starts at position:sticky below the hero,
  // then once the hero scrolls out of view it sticks to the top.
  const nav = document.getElementById('home-subnav');
  const hero = document.querySelector('.sticky-header');

  if (nav && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle('sticky-nav--stuck', !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: '0px 0px 0px 0px' }
    );
    observer.observe(hero);
  }
</script>

<style>
  .home-layout {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  
</style>
