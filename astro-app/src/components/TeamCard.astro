---
import { INSTITUTION_COLORS } from '../data/domains.js';

interface Props {
  member: any;
  variant?: 'full' | 'thumbnail' | 'lead';
}

const { member, variant = 'full' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const photoUrl = `${base}${member.photo.replace(/^\//, '')}`;
const nameColor = member.institution ? INSTITUTION_COLORS[member.institution] : undefined;
---

{variant === 'thumbnail' ? (
  <div class="team-member-thumbnail">
    <img src={photoUrl} alt={member.name} />
    <p>{member.name}</p>
  </div>
) : variant === 'lead' ? (
  <article class="card lead-card glass--soft">
    <div class="card-header">
      <div class="card-info-header">
        <h3 class="card-title" style={nameColor ? { color: nameColor } : {}}>{member.name}</h3>
      </div>
    </div>
    
    <div class="card-body">
      <div class="team-profile-layout">
        <div class="team-photo">
          <img src={photoUrl} alt={member.name} />
        </div>
        <div class="team-details">
          {member.affiliation && (
            <div class="mb-1 team-affiliation">
              <span class="institution-label"><strong>Institution:</strong> </span><i>{member.affiliation}</i>
            </div>
          )}
          {(member.siteLeadRole || member.role) && (
            <p class="card-header-role">{(member.siteLeadRole || member.role)}</p>
          )}
          {(member.siteLeadBackground || member.background) && (
            <p class="lead-background">{(member.siteLeadBackground || member.background)}</p>
          )}
        </div>
      </div>
    </div>
  </article>
) : (
  <article class="card team-card glass--soft">
    <div class="card-header">
      <div class="card-info-header">
        <h3 class="card-title" style={nameColor ? { color: nameColor } : {}}>{member.name}</h3>
      </div>
    </div>
    
    <div class="card-body">
      <div class="team-profile-layout">
        <div class="team-photo">
          <img src={photoUrl} alt={member.name} />
        </div>
        <div class="team-details">
          {member.affiliation && (
            <div class="mb-1 team-affiliation">
              <span class="institution-label"><strong>Institution:</strong> </span><i>{member.affiliation}</i>
            </div>
          )}
          {(member.siteLeadRole || member.role) && (
            <p class="card-header-role">{(member.siteLeadRole || member.role)}</p>
          )}
          {(member.siteLeadBackground || member.background) && (
            <p class="lead-background">{(member.siteLeadBackground || member.background)}</p>
          )}
          {member.focus && (
            <p class="team-focus"><strong>Focus:</strong> {member.focus}</p>
          )}
          {member.notable && member.notable !== (member.siteLeadBackground || member.background) && (
            <p class="team-notable"><strong>Notable:</strong> {member.notable}</p>
          )}
        </div>
      </div>
    </div>
  </article>
)}
