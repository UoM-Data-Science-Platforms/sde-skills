---
import SkillsFramework from '../components/SkillsFramework.jsx';
import Layout from '../layouts/Layout.astro';
import { DOMAINS } from '../data/domains.js';

export async function getStaticPaths() {
  const paths = [
    { params: { slug: 'technology-engineering' } },
    { params: { slug: 'access-identity' } },
    { params: { slug: 'data-management' } },
    { params: { slug: 'governance-compliance' } },
    { params: { slug: 'outputs-disclosure-control' } },
    { params: { slug: 'projects-operations' } },
    { params: { slug: 'skills-index' } },
  ];
  return paths;
}

const { slug } = Astro.params;
const domain = DOMAINS.find(d => d.id === slug);
const pageTitle = domain ? `${domain.name} — SDE Team Development Hub` : `Skills Framework — SDE Team Development Hub`;
---
<Layout title={pageTitle} currentDomain={slug}>
  <SkillsFramework client:load />
</Layout>
