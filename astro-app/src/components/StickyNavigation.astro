---
interface Props {
  sections: {
    id: string;
    label: string;
    subsections?: { id: string; label: string }[];
  }[];
  id?: string;
  className?: string;
}

const { sections, id = 'page-subnav', className = '' } = Astro.props;
---

<nav class={`sticky-nav ${className}`.trim()} id={id} role="navigation" aria-label="Page sections">
  <div class="nav nav-tabs sticky-nav-top" id="section-tabs">
    {sections.map(s => (
      <button class="nav-link tab subdomain-tab" data-section={s.id}>
        {s.label}
      </button>
    ))}
  </div>
  <div class="nav nav-tabs sticky-nav-sub" id="subsection-tabs"></div>
</nav>

<script is:inline define:vars={{ sections }}>
  window._pageSections = sections;
</script>
<script>
  import { initScrollSync } from '../scripts/scrollSync.js';
  if (window._pageSections && !window._scrollSyncInit) {
    initScrollSync({ sections: window._pageSections });
    window._scrollSyncInit = true;
  }
</script>
